AI_MODE=stub
# For the new engines set AI_MODE=engine, then change only ENGINE to compare.
ENGINE=light
SANA_DB=data/sana.sqlite3
HOST=127.0.0.1
PORT=8000
# Engine mode requires configured actor and a DIFFERENT judge model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ACTOR_PROVIDER=openai
ACTOR_MODEL=gpt-4.1-mini
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4.1-nano
LIGHT_JUDGE=1
LIGHT_MAX_ROUNDS=2
ANSWER_TIMEOUT_S=900
AI_ACTOR_MODEL=
AI_JUDGE_MODEL=
AI_MAX_CALLS=16
AI_MODEL_TIMEOUT=45
AI_RUN_TIMEOUT=1800
AI_MAX_SECONDS=180
# Optional NVIDIA NIM; configure independently from OpenAI.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
# A Brev infrastructure coupon is not an NVIDIA API key.
# For NVIDIA NIM set ACTOR_PROVIDER or JUDGE_PROVIDER=nvidia and a supported model.
GIGACHAT_AUTH_KEY=
GIGACHAT_CA_BUNDLE=
# Independent judge provider (set only after testing its model):
# AI_JUDGE_API_KEY=
# AI_JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
